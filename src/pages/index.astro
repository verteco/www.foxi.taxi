---
/**
 * Root page — detects browser language and redirects to the correct locale.
 * Static build generates HTML with client-side JS redirect.
 */
import Layout from '../layouts/Layout.astro';
import { supportedLangs, defaultLang } from '../i18n/translations';
---

<Layout title="FOXI TAXI" description="Fast, reliable taxi service." lang="en">
  <script define:vars={{ supportedLangs, defaultLang }}>
    // Detect browser language and redirect
    const browserLangs = navigator.languages || [navigator.language];
    let target = defaultLang;

    for (const bl of browserLangs) {
      const short = bl.split('-')[0].toLowerCase();
      if (supportedLangs.includes(short)) {
        target = short;
        break;
      }
    }

    // Redirect to language-specific page
    const path = target === defaultLang ? '/en/' : `/${target}/`;
    if (window.location.pathname === '/') {
      window.location.replace(path);
    }
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0;url=/en/" />
  </noscript>
  <div style="min-height:100vh;display:flex;align-items:center;justify-content:center;">
    <div class="hero-badge" style="font-size:16px;">Redirecting...</div>
  </div>
</Layout>
