---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — FOXI TAXI" description="Page not found." lang="sk" noindex={true}>
  <div style="min-height:100vh;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:24px;">
    <h1 style="font-size:clamp(4rem,10vw,8rem);font-weight:900;background:linear-gradient(135deg,var(--accent),#ff9a56);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;margin-bottom:16px;">404</h1>
    <p style="font-size:18px;color:var(--gray-300);margin-bottom:32px;font-weight:300;">Stránka nebola nájdená</p>
    <a href="/sk/" class="btn btn-primary">Späť na hlavnú stránku</a>
  </div>
</Layout>
