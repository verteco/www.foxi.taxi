---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
import { DEFAULT_REGION, REGIONS } from '../data/regions';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = (key: string) => t(lang, key);
const region = DEFAULT_REGION;

// Build regions JSON for client-side script
const regionsJson = JSON.stringify(
  Object.fromEntries(
    Object.entries(REGIONS).map(([code, r]) => [
      code,
      {
        phone: r.phone,
        display: r.phoneDisplay,
        country: r.country,
        city: r.city,
        flag: r.flag,
        operator: r.operator,
        phoneSecondary: r.phoneSecondary,
        phoneSecondaryDisplay: r.phoneSecondaryDisplay,
      },
    ]),
  ),
);
---

<!-- Navbar -->
<nav class="navbar">
  <div class="navbar-inner">
    <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="logo-link">
      <img src="/images/logo-small.png" alt="FOXI" class="logo-img" />
      <span class="logo-text">FOXI<span class="taxi">.TAXI</span></span>
    </a>
    <a href={`tel:${region.phone}`} class="nav-phone" id="nav-phone-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span id="nav-phone-number">{region.phoneDisplay}</span>
    </a>
  </div>
</nav>

<!-- Hero -->
<section class="hero">
  <img src="/images/foxi-mascot.png" alt="" class="hero-mascot" aria-hidden="true" />
  <div class="hero-badge">
    <span id="hero-flag">{region.flag}</span>
    <span id="hero-region">{region.country}</span>
  </div>
  <h1>
    {i('hero.title')}<br/>
    <span class="accent">{i('hero.titleAccent')}</span>
  </h1>
  <p>{i('hero.subtitle')}</p>
  <div class="hero-buttons">
    <a href={`tel:${region.phone}`} class="btn btn-primary" id="cta-call">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {i('hero.callNow')}
    </a>
  </div>
  <div class="phone-display" id="phone-display">{region.phoneDisplay}</div>
  <div class="phone-secondary" id="phone-secondary"></div>
  <div class="region-label" id="region-label">{region.country}</div>
  <div class="operator-label" id="operator-label"></div>
</section>

<!-- Features -->
<section class="features">
  <div class="container">
    <h2>{i('features.title')}</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#x23F1;&#xFE0F;</div>
        <h3>{i('features.fast.title')}</h3>
        <p>{i('features.fast.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F6E1;&#xFE0F;</div>
        <h3>{i('features.safe.title')}</h3>
        <p>{i('features.safe.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F4B0;</div>
        <h3>{i('features.price.title')}</h3>
        <p>{i('features.price.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F319;</div>
        <h3>{i('features.available.title')}</h3>
        <p>{i('features.available.desc')}</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta">
  <h2>{i('cta.title')}</h2>
  <p>{i('cta.subtitle')}</p>
  <a href={`tel:${region.phone}`} class="cta-phone" id="cta-phone">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>{i('cta.call')} <span id="cta-phone-number">{region.phoneDisplay}</span></span>
  </a>
</section>

<!-- Footer -->
<footer>
  <div class="footer-inner">
    <div class="footer-left">
      {i('footer.copyright').replace('{year}', new Date().getFullYear().toString())}
    </div>
    <div class="footer-tagline">
      {i('footer.tagline')}
    </div>
  </div>
</footer>

<!-- Client-side geolocation — updates phone numbers based on visitor country -->
<script define:vars={{ regionsJson }}>
  const REGIONS = JSON.parse(regionsJson);

  async function detectGeo() {
    // Skip if already geo-detected via CF
    const badge = document.getElementById('hero-region');
    if (badge && badge.textContent !== 'International') return;

    try {
      const res = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(3000) });
      const data = await res.json();
      const cc = data?.country_code?.toUpperCase();
      const region = cc && REGIONS[cc] ? REGIONS[cc] : null;
      if (!region) return;

      // Update phone numbers
      document.querySelectorAll('#nav-phone-number, #phone-display, #cta-phone-number').forEach(el => {
        el.textContent = region.display;
      });

      // Update tel: links
      document.querySelectorAll('#cta-call, #cta-phone, #nav-phone-link').forEach(el => {
        el.href = `tel:${region.phone}`;
      });

      // Update region info
      if (badge) badge.textContent = region.country;
      const flag = document.getElementById('hero-flag');
      if (flag) flag.textContent = region.flag;
      const label = document.getElementById('region-label');
      if (label) label.textContent = region.city ? `${region.city}, ${region.country}` : region.country;

      // Operator name
      const op = document.getElementById('operator-label');
      if (op && region.operator && region.operator !== 'Coming soon') {
        op.textContent = `Operated by ${region.operator}`;
      }

      // Secondary phone
      const sec = document.getElementById('phone-secondary');
      if (sec && region.phoneSecondaryDisplay) {
        sec.innerHTML = `<a href="tel:${region.phoneSecondary}" style="color: var(--gray-300); font-size: 16px;">${region.phoneSecondaryDisplay}</a>`;
      }
    } catch { /* Silent fail — keep default */ }
  }

  detectGeo();
</script>
