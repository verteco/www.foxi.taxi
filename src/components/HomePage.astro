---
import type { Lang } from '../i18n/translations';
import { t } from '../i18n/translations';
import { getCitiesForLang, getDefaultRegion, getRegionsForGeo } from '../data/loader';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const i = (key: string) => t(lang, key);
const region = getDefaultRegion();
const cities = getCitiesForLang(lang);

// Build regions JSON for client-side geo detection
const regionsJson = JSON.stringify(getRegionsForGeo());
---

<!-- Navbar -->
<nav class="navbar">
  <div class="navbar-inner">
    <a href={`/${lang === 'en' ? '' : lang + '/'}`} class="logo-link">
      <span class="logo-text">FOXI<span class="taxi">.TAXI</span></span>
    </a>
    <a href={`tel:${region.phone}`} class="nav-phone" id="nav-phone-link">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      <span id="nav-phone-number">{region.phoneDisplay}</span>
    </a>
  </div>
</nav>

<!-- Hero -->
<section class="hero">
  <img src="/images/foxi-mascot-opt.jpg" alt="" class="hero-mascot" aria-hidden="true" />
  <div class="hero-badge">
    <span id="hero-flag">&#127757;</span>
    <span id="hero-region">{lang === 'sk' ? 'Detekujem polohu...' : lang === 'cs' ? 'Detekuji polohu...' : lang === 'hu' ? 'Helymeghatározás...' : lang === 'pl' ? 'Wykrywanie lokalizacji...' : lang === 'ro' ? 'Detectare locație...' : 'Detecting location...'}</span>
  </div>
  <h1>
    {i('hero.title')}<br/>
    <span class="accent">{i('hero.titleAccent')}</span>
  </h1>
  <p>{i('hero.subtitle')}</p>
  <div class="hero-buttons">
    <a href={`tel:${region.phone}`} class="btn btn-primary" id="cta-call">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      {i('hero.callNow')}
    </a>
  </div>
  <div class="phone-display" id="phone-display">{region.phoneDisplay}</div>
  <div class="phone-secondary" id="phone-secondary"></div>
  <div class="region-label" id="region-label">{region.country}</div>
  <div class="operator-label" id="operator-label"></div>
</section>

<!-- How It Works -->
<section class="how-it-works fade-section">
  <div class="container">
    <h2>{i('howItWorks.title')}</h2>
    <div class="steps-grid">
      <div class="step-card">
        <div class="step-number">1</div>
        <h3>{i('howItWorks.step1.title')}</h3>
        <p>{i('howItWorks.step1.desc')}</p>
      </div>
      <div class="step-connector" aria-hidden="true">
        <svg width="40" height="24" viewBox="0 0 40 24"><path d="M0 12h32m-8-8 8 8-8 8" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="step-card">
        <div class="step-number">2</div>
        <h3>{i('howItWorks.step2.title')}</h3>
        <p>{i('howItWorks.step2.desc')}</p>
      </div>
      <div class="step-connector" aria-hidden="true">
        <svg width="40" height="24" viewBox="0 0 40 24"><path d="M0 12h32m-8-8 8 8-8 8" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </div>
      <div class="step-card">
        <div class="step-number">3</div>
        <h3>{i('howItWorks.step3.title')}</h3>
        <p>{i('howItWorks.step3.desc')}</p>
      </div>
    </div>
  </div>
</section>

<!-- Features -->
<section class="features fade-section">
  <div class="container">
    <h2>{i('features.title')}</h2>
    <div class="features-grid">
      <div class="feature-card">
        <div class="feature-icon">&#x23F1;&#xFE0F;</div>
        <h3>{i('features.fast.title')}</h3>
        <p>{i('features.fast.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F6E1;&#xFE0F;</div>
        <h3>{i('features.safe.title')}</h3>
        <p>{i('features.safe.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F4B0;</div>
        <h3>{i('features.price.title')}</h3>
        <p>{i('features.price.desc')}</p>
      </div>
      <div class="feature-card">
        <div class="feature-icon">&#x1F319;</div>
        <h3>{i('features.available.title')}</h3>
        <p>{i('features.available.desc')}</p>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta fade-section">
  <h2>{i('cta.title')}</h2>
  <p>{i('cta.subtitle')}</p>
  <a href={`tel:${region.phone}`} class="cta-phone pulse-glow" id="cta-phone">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
    <span>{i('cta.call')} <span id="cta-phone-number">{region.phoneDisplay}</span></span>
  </a>
</section>

<!-- Floating mobile CTA -->
<a href={`tel:${region.phone}`} class="floating-cta" id="floating-cta" aria-label={i('hero.callNow')}>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
</a>

<!-- Footer -->
<footer>
  <div class="footer-brand">
    <span class="footer-brand-name">FOXI<span class="taxi">.TAXI</span></span>
    <div class="footer-tagline">{i('footer.tagline')}</div>
    <a href="https://www.foxifood.com" target="_blank" rel="noopener" class="footer-powered-by">
      {lang === 'sk' ? 'Služba platformy' : lang === 'cs' ? 'Služba platformy' : lang === 'hu' ? 'A platform szolgáltatása' : lang === 'pl' ? 'Usługa platformy' : lang === 'ro' ? 'Un serviciu al platformei' : 'A service by'} <strong>FOXI.FOOD</strong>
    </a>
  </div>
  <div class="footer-inner">
    <div class="footer-left">
      {i('footer.copyright').replace('{year}', new Date().getFullYear().toString())}
    </div>
  </div>

  <!-- Dropdowns: Language + Region -->
  <div class="footer-selector">
    <!-- Language dropdown -->
    <div class="footer-dropdown" id="dd-lang">
      <button class="footer-dropdown-toggle" type="button" onclick="this.parentElement.classList.toggle('open')">
        <div>
          <div class="toggle-label">{lang === 'sk' ? 'Jazyk' : lang === 'cs' ? 'Jazyk' : lang === 'hu' ? 'Nyelv' : lang === 'pl' ? 'Język' : lang === 'ro' ? 'Limbă' : 'Language'}</div>
          <div class="toggle-value">{lang === 'en' ? 'English' : lang === 'sk' ? 'Slovenčina' : lang === 'cs' ? 'Čeština' : lang === 'hu' ? 'Magyar' : lang === 'pl' ? 'Polski' : lang === 'ro' ? 'Română' : 'English'}</div>
        </div>
        <svg class="toggle-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
      </button>
      <div class="footer-dropdown-panel">
        <a href="/en/" class:list={[{ active: lang === 'en' }]}>English</a>
        <a href="/sk/" class:list={[{ active: lang === 'sk' }]}>Slovenčina</a>
        <a href="/cs/" class:list={[{ active: lang === 'cs' }]}>Čeština</a>
        <a href="/hu/" class:list={[{ active: lang === 'hu' }]}>Magyar</a>
        <a href="/pl/" class:list={[{ active: lang === 'pl' }]}>Polski</a>
        <a href="/ro/" class:list={[{ active: lang === 'ro' }]}>Română</a>
      </div>
    </div>

    <!-- City/Region dropdown -->
    <div class="footer-dropdown" id="dd-region">
      <button class="footer-dropdown-toggle" type="button" onclick="this.parentElement.classList.toggle('open')">
        <div>
          <div class="toggle-label">{lang === 'sk' ? 'Mesto' : lang === 'cs' ? 'Město' : lang === 'hu' ? 'Város' : lang === 'pl' ? 'Miasto' : lang === 'ro' ? 'Oraș' : 'City'}</div>
          <div class="toggle-value" id="dd-region-value">{lang === 'sk' ? 'Vyberte mesto' : lang === 'cs' ? 'Vyberte město' : lang === 'hu' ? 'Válasszon várost' : lang === 'pl' ? 'Wybierz miasto' : lang === 'ro' ? 'Selectați orașul' : 'Select city'}</div>
        </div>
        <svg class="toggle-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="m18 15-6-6-6 6"/></svg>
      </button>
      <div class="footer-dropdown-panel">
        {cities.map(c => (
          <a href={`/${lang}/${c.slug}/`}>
            <span>{c.name}</span>
            {c.isActive ? (
              <span class="dd-phone">{c.phoneDisplay}</span>
            ) : (
              <span class="dd-soon">Coming soon</span>
            )}
          </a>
        ))}
      </div>
    </div>
  </div>
</footer>

<!-- Close dropdowns when clicking outside + scroll animations -->
<script>
  document.addEventListener('click', (e) => {
    document.querySelectorAll('.footer-dropdown.open').forEach(dd => {
      if (!dd.contains(e.target as Node)) dd.classList.remove('open');
    });
  });

  // Fade-in sections on scroll
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
        observer.unobserve(entry.target);
      }
    });
  }, { threshold: 0.15 });

  document.querySelectorAll('.fade-section').forEach(el => observer.observe(el));

  // Show/hide floating CTA after scrolling past hero
  const floatingCta = document.getElementById('floating-cta');
  if (floatingCta) {
    let shown = false;
    window.addEventListener('scroll', () => {
      const shouldShow = window.scrollY > window.innerHeight * 0.6;
      if (shouldShow !== shown) {
        shown = shouldShow;
        floatingCta.classList.toggle('show', shouldShow);
      }
    }, { passive: true });
  }
</script>

<!-- Client-side geolocation — 2s timeout, then fallback to language -->
<script define:vars={{ regionsJson, lang }}>
  const REGIONS = JSON.parse(regionsJson);

  // Language → country fallback mapping
  const LANG_FALLBACK: Record<string, string> = {
    sk: 'SK', cs: 'CZ', hu: 'HU', pl: 'PL', ro: 'RO', en: 'SK',
  };

  let resolved = false;

  function applyRegion(region: any) {
    if (resolved) return;
    resolved = true;

    const badge = document.getElementById('hero-region');
    const flag = document.getElementById('hero-flag');
    const label = document.getElementById('region-label');
    const op = document.getElementById('operator-label');
    const sec = document.getElementById('phone-secondary');

    // Phone numbers
    document.querySelectorAll('#nav-phone-number, #phone-display, #cta-phone-number').forEach(el => {
      el.textContent = region.display;
    });
    document.querySelectorAll('#cta-call, #cta-phone, #nav-phone-link').forEach(el => {
      (el as HTMLAnchorElement).href = `tel:${region.phone}`;
    });

    // Region badge
    if (badge) badge.textContent = region.country;
    if (flag) flag.textContent = region.flag;
    if (label) label.textContent = region.city ? `${region.city}, ${region.country}` : region.country;

    // Operator
    if (op && region.operator && region.operator !== 'Coming soon') {
      op.textContent = `Operated by ${region.operator}`;
    }

    // Secondary phone
    if (sec && region.phoneSecondaryDisplay) {
      sec.innerHTML = `<a href="tel:${region.phoneSecondary}" style="color:var(--gray-300);font-size:16px">${region.phoneSecondaryDisplay}</a>`;
    }
  }

  function applyFallback() {
    const cc = LANG_FALLBACK[lang] || 'SK';
    const region = REGIONS[cc];
    if (region) applyRegion(region);
  }

  // Race: geo detection (2s max) vs fallback
  const fallbackTimer = setTimeout(applyFallback, 2000);

  fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(2000) })
    .then(r => r.json())
    .then(data => {
      clearTimeout(fallbackTimer);
      const cc = data?.country_code?.toUpperCase();
      const region = cc && REGIONS[cc] ? REGIONS[cc] : null;
      if (region) {
        applyRegion(region);
      } else {
        applyFallback();
      }
    })
    .catch(() => {
      clearTimeout(fallbackTimer);
      applyFallback();
    });
</script>
