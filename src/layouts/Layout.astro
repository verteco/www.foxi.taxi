---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  phone?: string;
  cityName?: string;
  countryName?: string;
  lat?: number;
  lng?: number;
  noindex?: boolean;
  faq?: { q: string; a: string }[];
}

const { title, description, lang = 'en', phone = '+421 948 355 017', cityName, countryName, lat, lng, noindex = false, faq } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="FOXI TAXI" />
    <meta property="og:image" content="https://www.foxi.taxi/images/og-image.png" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.foxi.taxi/images/og-image.png" />

    <!-- Font: preconnect + preload for fast render -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-fox.png" />
    <meta name="theme-color" content="#2198d6" />

    <!-- Google Analytics 4 — replace G-XXXXXXXXXX with your Measurement ID -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-XXXXXXXXXX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-XXXXXXXXXX');
    </script>

    <!-- Hreflang alternates -->
    <link rel="alternate" hreflang="sk" href={`https://www.foxi.taxi/sk${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="cs" href={`https://www.foxi.taxi/cs${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="hu" href={`https://www.foxi.taxi/hu${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="pl" href={`https://www.foxi.taxi/pl${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="ro" href={`https://www.foxi.taxi/ro${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="en" href={`https://www.foxi.taxi/en${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="de" href={`https://www.foxi.taxi/de${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />
    <link rel="alternate" hreflang="x-default" href={`https://www.foxi.taxi/sk${Astro.url.pathname.replace(/^\/(sk|cs|hu|pl|ro|en|de)/, '')}`} />

    <!-- Schema.org TaxiService -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TaxiService",
      "name": cityName ? `Taxi ${cityName} | FOXI TAXI` : "FOXI TAXI",
      "url": canonicalURL,
      "telephone": phone,
      "description": description,
      "areaServed": {
        "@type": lat ? "City" : "GeoCircle",
        ...(lat ? { "name": cityName } : {
          "geoMidpoint": { "@type": "GeoCoordinates", "latitude": 48.63, "longitude": 21.72 },
          "geoRadius": "100000"
        }),
        ...(lat ? { "geo": { "@type": "GeoCoordinates", "latitude": lat, "longitude": lng } } : {})
      },
      "openingHoursSpecification": {
        "@type": "OpeningHoursSpecification",
        "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
        "opens": "00:00",
        "closes": "23:59"
      },
      "priceRange": "$",
      "availableChannel": {
        "@type": "ServiceChannel",
        "servicePhone": { "@type": "ContactPoint", "telephone": phone, "contactType": "reservations", "availableLanguage": ["Slovak", "Czech", "English", "German", "Hungarian", "Polish", "Romanian"] }
      }
    })} />

    {/* BreadcrumbList Schema — helps Google show breadcrumbs in SERP */}
    {cityName && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "BreadcrumbList",
        "itemListElement": [
          { "@type": "ListItem", "position": 1, "name": "FOXI TAXI", "item": `https://www.foxi.taxi/${lang}/` },
          ...(countryName ? [{ "@type": "ListItem", "position": 2, "name": countryName, "item": `https://www.foxi.taxi/${lang}/` }] : []),
          { "@type": "ListItem", "position": countryName ? 3 : 2, "name": `Taxi ${cityName}` }
        ]
      })} />
    )}

    {/* FAQ Schema.org — for Google featured snippets */}
    {faq && faq.length > 0 && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "FAQPage",
        "mainEntity": faq.map(item => ({
          "@type": "Question",
          "name": item.q,
          "acceptedAnswer": {
            "@type": "Answer",
            "text": item.a,
          },
        })),
      })} />
    )}
  </head>
  <body>
    <slot />
  </body>
</html>
